{
  "name": "runware-mcp",
  "version": "3.0.0",
  "description": "MCP server for Runware AI media generation and model discovery",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ul0gic/runware-mcp.git"
  },
  "type": "module",
  "bin": {
    "runware-mcp": "dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest --coverage",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "lint": "biome check .",
    "knip": "knip",
    "audit:security": "npm audit --omit=dev --audit-level=moderate",
    "audit:signatures": "npm audit signatures",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "lint:fix": "biome check --write .",
    "sast": "bash scripts/codeql.sh"
  },
  "engines": {
    "node": ">=26.13.1"
  },
  "license": "MIT",
  "keywords": [
    "mcp",
    "runware",
    "ai",
    "image-generation",
    "video-generation",
    "mcp-server"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "ajv": "8.20.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "knip": "6.45.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
