{
  "name": "runware-mcp",
  "version": "2.0.4",
  "description": "MCP server for Runware AI media generation and model discovery",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ul0gic/runware-mcp.git"
  },
  "type": "module",
  "bin": {
    "runware-mcp": "dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --external 'node:*'",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "knip": "knip",
    "audit:security": "npm audit --audit-level=moderate",
    "audit:signatures": "npm audit signatures",
    "audit:outdated": "npm outdated --omit=dev --long",
    "check": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "engines": {
    "node": ">=26"
  },
  "license": "MIT",
  "keywords": [
    "mcp",
    "runware",
    "ai",
    "image-generation",
    "video-generation",
    "mcp-server"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "ajv": "8.20.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-security": "4.2.1",
    "eslint-plugin-sonarjs": "4.2.2",
    "eslint-plugin-unicorn": "79.0.0",
    "jiti": "^2.7.0",
    "knip": "6.44.0",
    "tsup": "9.0.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  },
  "overrides": {
    "@hono/node-server": "2.1.5"
  }
}
