{
  "name": "runware-mcp",
  "version": "2.0.1",
  "description": "MCP server for Runware AI media generation and model discovery",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ul0gic/runware-mcp.git"
  },
  "type": "module",
  "bin": {
    "runware-mcp": "dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --external 'node:*'",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "knip": "knip",
    "audit:security": "npm audit --audit-level=moderate",
    "audit:signatures": "npm audit signatures",
    "audit:outdated": "npm outdated --omit=dev --long",
    "check": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "engines": {
    "node": ">=26"
  },
  "license": "MIT",
  "keywords": [
    "mcp",
    "runware",
    "ai",
    "image-generation",
    "video-generation",
    "mcp-server"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "ajv": "8.20.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.7.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-security": "^4.0.1",
    "eslint-plugin-sonarjs": "^4.2.0",
    "eslint-plugin-unicorn": "^64.0.0",
    "jiti": "^2.7.0",
    "knip": "6.32.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "@hono/node-server": "2.0.11"
  }
}
